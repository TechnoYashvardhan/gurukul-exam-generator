# ── App ──────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=your_super_secret_jwt_key_change_in_production

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./examgen.db
SYNC_DATABASE_URL=sqlite:///./examgen.db

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ── LLM Configuration ────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-1.5-flash

# Optional: Groq & Ollama
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# ── Rate limiting ─────────────────────────────────
LLM_RATE_LIMIT_PER_MIN=15
LLM_MAX_RETRIES=2
